# ─── Environment Variables Template ───────────────────────────────────────────
# Copy this file to .env (or paste into Railway → Service → Variables)
# and fill in your own values. Never commit real secrets.
# ──────────────────────────────────────────────────────────────────────────────

APP_ENV=production
DEPLOYMENT_MODE=production

# ── Database ──────────────────────────────────────────────────────────────────
# On Railway, use the ${{Postgres.DATABASE_URL}} reference
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# ── Redis ─────────────────────────────────────────────────────────────────────
# On Railway, use the ${{Redis.REDIS_URL}} reference
# Format: redis://<user>:<password>@<host>:<port>
REDIS_URL=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a long random string, e.g. `openssl rand -hex 32`
SECRET_KEY=
# Must be exactly 32 characters
ENCRYPTION_KEY=

# ── Frontend / CORS ───────────────────────────────────────────────────────────
# Your deployed frontend URL, e.g. https://your-frontend.up.railway.app
FRONTEND_URL=
# JSON array of allowed origins, e.g. ["https://your-frontend.up.railway.app"]
CORS_ORIGINS=[]

# Auto-injected by Railway at runtime — leave blank
RAILWAY_PUBLIC_DOMAIN=
RAILWAY_STATIC_URL=

# ── Groq LLM ──────────────────────────────────────────────────────────────────
# Comma-separated list of keys, e.g. key1,key2,key3
GROQ_API_KEYS=
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# ── Gemini / Google ───────────────────────────────────────────────────────────
GEMINI_API_KEY=
GOOGLE_API_KEY=

# ── Pexels ────────────────────────────────────────────────────────────────────
PEXELS_API_KEY=

# ── Vercel (store preview deployments) ────────────────────────────────────────
VERCEL_TOKEN=
VERCEL_SCOPE=
VERCEL_PROJECT_PREFIX=asea

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# e.g. https://your-frontend.up.railway.app/auth/github/callback
GITHUB_REDIRECT_URI=

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
# For Gmail, use an App Password (not your account password)
SMTP_PASSWORD=
EMAIL_FROM=
CONTACT_EMAIL=

# ── Storage paths (Railway is ephemeral — use /tmp) ───────────────────────────
STORAGE_PATH=/tmp/asea/projects
ARTIFACT_PATH=/tmp/asea/artifacts

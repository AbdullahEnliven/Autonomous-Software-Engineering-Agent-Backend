# ─── Railway Deployment Environment Template ──────────────────────────────────
# Copy this file, fill in your values, and paste into Railway → Service → Variables
# ──────────────────────────────────────────────────────────────────────────────

APP_ENV=production
DEPLOYMENT_MODE=production

# ── Database (Railway PostgreSQL — use the ${{Postgres.DATABASE_URL}} reference) ─
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/railway

# ── Redis (Railway Redis — use ${{Redis.REDIS_URL}} reference) ─
REDIS_URL=redis://default:password@host:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-32-char-key

# ── Frontend / CORS ───────────────────────────────────────────────────────────
# Set this to your Railway frontend public domain once deployed
# e.g. https://asea-frontend.up.railway.app
FRONTEND_URL=https://your-frontend.up.railway.app
CORS_ORIGINS=["https://your-frontend.up.railway.app"]

# Railway auto-injects this — leave blank here, Railway sets it at runtime
RAILWAY_PUBLIC_DOMAIN=
RAILWAY_STATIC_URL=

# ── Groq LLM ─────────────────────────────────────────────────────────────────
GROQ_API_KEYS=key1,key2,key3
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# ── Gemini / Google ───────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-key
GOOGLE_API_KEY=your-google-api-key

# ── Pexels ────────────────────────────────────────────────────────────────────
PEXELS_API_KEY=your-pexels-key

# ── Vercel (for store preview deployments) ────────────────────────────────────
VERCEL_TOKEN=your-vercel-token
VERCEL_SCOPE=
VERCEL_PROJECT_PREFIX=asea

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# Update this to your Railway frontend URL
GITHUB_REDIRECT_URI=https://your-frontend.up.railway.app/auth/github/callback

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your@gmail.com
CONTACT_EMAIL=your@gmail.com

# ── Storage paths (Railway ephemeral — use /tmp) ──────────────────────────────
STORAGE_PATH=/tmp/asea/projects
ARTIFACT_PATH=/tmp/asea/artifacts

# Deployment Configuration

# deployment_mode: "local" for development, "production" for live
DEPLOYMENT_MODE=local

# Port for local deployments (when running manual http.server)
LOCAL_DEPLOYMENT_PORT=3000

# Domain for production deployments
DEPLOYMENT_DOMAIN=enliven-app.com

# Backend URL (used by deployed apps to call API)
# Leave as localhost:8000 for local testing
# Change to your domain for production
BACKEND_URL=http://localhost:8000

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173

# Additional CORS origins (comma-separated if needed)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://localhost:3000
